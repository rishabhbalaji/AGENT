# Copy this file to a local .env only when the application supports it.
# Never commit the copied file or replace placeholders with real secrets here.

# Absolute path to the UUID-backed SDA data root.
ENGINE_DATA_ROOT=/mnt/sda/job-engine

# Bind the dashboard to the server's Tailscale address, not 0.0.0.0.
ENGINE_BIND_HOST=100.64.0.10
ENGINE_BIND_PORT=8080

# Ollama is hosted on rbkmsi and accessed over Tailscale.
OLLAMA_BASE_URL=http://100.64.0.20:11434
OLLAMA_TRIAGE_MODEL=configure-later
OLLAMA_TAILORING_MODEL=configure-later
OLLAMA_EMBEDDING_MODEL=configure-later

# Optional credentials are supplied later through systemd credentials or Vaultwarden.
# GITHUB_READONLY_TOKEN=
# IMAP_USERNAME=
# IMAP_PASSWORD=
# VAULTWARDEN_URL=

# Set explicitly in a local environment when the feature exists.
ENGINE_ENV=development
